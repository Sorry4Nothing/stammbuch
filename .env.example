# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (steht in .gitignore).
# Nie echte Zugangsdaten in diese Datei schreiben.

# --- Datenbank (docker-compose.yml, Dienst stammbuch-db) ---
POSTGRES_USER=stammbuch
POSTGRES_DB=stammbuch
# Lokal ein zufälliges Passwort setzen, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN

# --- API ---
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300
# Nur auf true setzen, wenn ein vertrauenswürdiger Reverse-Proxy davorsteht
TRUST_PROXY=false

# --- Anmeldung (apps/api/src/modules/auth) ---
# Pepper für Passwort-Hashes: "id:geheimnis", mehrere kommagetrennt (erster = aktuell, Rotation).
# Mindestens 32 Zeichen, z. B.: p1:$(openssl rand -base64 36)
AUTH_PEPPERS=p1:HIER_LOKAL_EIN_ZUFAELLIGES_GEHEIMNIS_MIT_MIND_32_ZEICHEN
# 32 Byte base64 (verschlüsselt TOTP-Geheimnisse, leitet HMAC-Schlüssel ab): openssl rand -base64 32
AUTH_TOTP_KEY=HIER_LOKAL_32_BYTE_BASE64_SETZEN
# Einzige erlaubte Origin der Oberfläche (CSRF-Prüfung)
APP_ORIGIN=http://localhost:5173
# Anfragen pro Minute und IP für die Auth-Routen
AUTH_RATE_LIMIT_MAX=10
