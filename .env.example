# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (steht in .gitignore).
# Nie echte Zugangsdaten in diese Datei schreiben.

# --- Datenbank (docker-compose.yml, Dienst stammbuch-db) ---
POSTGRES_USER=stammbuch
POSTGRES_DB=stammbuch
# Lokal ein zufälliges Passwort setzen, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN

# --- API ---
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300
# Nur auf true setzen, wenn ein vertrauenswürdiger Reverse-Proxy davorsteht
TRUST_PROXY=false

# --- Mail (nur lokale Platzhalter; echte Schlüssel gehören ins Secret-Management, SR-30) ---
# Schlüsselring für die Zugangsdaten der Mailkonten (AES-256-GCM): "id:base64,id2:base64",
# je 32 Byte, erzeugen mit: openssl rand -base64 32. Ohne Wert bleibt das Mail-Modul aus.
# Rotation: neuen Schlüssel mit neuer ID anhängen, MAIL_ENCRYPTION_KEY_ID umstellen, alten erst
# entfernen, wenn alle Konten neu verschlüsselt sind.
MAIL_ENCRYPTION_KEYS=
MAIL_ENCRYPTION_KEY_ID=
# Nur lokale Entwicklung (z. B. Test-Mailserver auf localhost). In Produktion verboten.
MAIL_ALLOW_PRIVATE_HOSTS=false
# Versandrate pro Kunde und Minute, Wiederholversuche, Grenzen
MAIL_RATE_PER_TENANT_PER_MINUTE=60
MAIL_MAX_ATTEMPTS=6
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_RECIPIENTS=5000
