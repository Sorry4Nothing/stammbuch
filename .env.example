# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (steht in .gitignore).
# Nie echte Zugangsdaten in diese Datei schreiben.

# --- Datenbank (docker-compose.yml, Dienst stammbuch-db) ---
POSTGRES_USER=stammbuch
POSTGRES_DB=stammbuch
# Lokal ein zufälliges Passwort setzen, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN

# --- API ---
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300
# Nur auf true setzen, wenn ein vertrauenswürdiger Reverse-Proxy davorsteht
TRUST_PROXY=false
# Verbindung der API als Rolle stammbuch_app (siehe packages/db/README.md), nie als Eigentümer.
# Ohne Wert startet die API nicht (fail closed). Lokal: Port 55432 aus docker-compose.yml.
DATABASE_URL=postgres://stammbuch_app:HIER_APP_DB_PASSWORT@127.0.0.1:55432/stammbuch
# Signiert die Formular-Tokens der öffentlichen Registrierung (SR-30), mind. 32 Byte, base64.
# Erzeugen mit: openssl rand -base64 32. In jeder Instanz derselbe Wert, nie einchecken.
FORM_SECRET=HIER_LOKAL_EIN_GEHEIMNIS_SETZEN
