# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (steht in .gitignore).
# Nie echte Zugangsdaten in diese Datei schreiben.

# --- Datenbank (docker-compose.yml, Dienst stammbuch-db) ---
POSTGRES_USER=stammbuch
POSTGRES_DB=stammbuch
# Lokal ein zufälliges Passwort setzen, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN

# --- API ---
# Verbindung der Rolle stammbuch_app (nie der Eigentümer). Ohne Wert startet die API nicht.
# Lokal passend zu docker-compose.yml (Port 55432) und APP_DB_PASSWORD, siehe packages/db/README.md.
DATABASE_URL=postgres://stammbuch_app:HIER_APP_DB_PASSWORD@127.0.0.1:55432/stammbuch
# Verbindung der Rolle stammbuch_worker (nur Lösch-Job des Kalenders). Passwort wie WORKER_DB_PASSWORD.
# Der Worker braucht beide URLs (DATABASE_URL für die Auth-Wartung).
WORKER_DATABASE_URL=postgres://stammbuch_worker:HIER_WORKER_DB_PASSWORD@127.0.0.1:55432/stammbuch
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300
# Nur auf true setzen, wenn ein vertrauenswürdiger Reverse-Proxy davorsteht
TRUST_PROXY=false

# --- Anmeldung (apps/api/src/modules/auth) ---
# Pepper für Passwort-Hashes: "id:geheimnis", mehrere kommagetrennt (erster = aktuell, Rotation).
# Mindestens 32 Zeichen, z. B.: p1:$(openssl rand -base64 36)
AUTH_PEPPERS=p1:HIER_LOKAL_EIN_ZUFAELLIGES_GEHEIMNIS_MIT_MIND_32_ZEICHEN
# 32 Byte base64 (verschlüsselt TOTP-Geheimnisse, leitet HMAC-Schlüssel ab): openssl rand -base64 32
AUTH_TOTP_KEY=HIER_LOKAL_32_BYTE_BASE64_SETZEN
# Einzige erlaubte Origin der Oberfläche (CSRF-Prüfung). Der Vite-Dev-Server (Port 5173) leitet /auth an
# http://127.0.0.1:3000 weiter; läuft die API woanders, API_PROXY_TARGET beim Start von `pnpm dev:web` setzen.
APP_ORIGIN=http://localhost:5173
# Anfragen pro Minute und IP für die Auth-Routen
AUTH_RATE_LIMIT_MAX=10

# --- Datenbankverbindungen (packages/db/README.md) ---
# Eigentümer: nur für Migrationen (pnpm --filter @stammbuch/db run migrate)
DATABASE_ADMIN_URL=postgres://stammbuch:HIER_POSTGRES_PASSWORT@127.0.0.1:55432/stammbuch
# Passwort der Anwendungsrolle stammbuch_app, setzt der Migrationslauf
APP_DB_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN
# API und Worker verbinden sich als stammbuch_app (nie als Eigentümer: sonst greift RLS nicht).
# In Produktion Pflicht (NODE_ENV=production).
DATABASE_URL=postgres://stammbuch_app:HIER_APP_DB_PASSWORD@127.0.0.1:55432/stammbuch

# Signiert die Formular-Tokens der öffentlichen Registrierung (SR-30), mind. 32 Byte, base64.
# Erzeugen mit: openssl rand -base64 32. In jeder Instanz derselbe Wert, nie einchecken.
FORM_SECRET=HIER_LOKAL_EIN_GEHEIMNIS_SETZEN

# --- Mail (nur lokale Platzhalter; echte Schlüssel gehören ins Secret-Management, SR-30) ---
# Schlüsselring für die Zugangsdaten der Mailkonten (AES-256-GCM): "id:base64,id2:base64",
# je 32 Byte, erzeugen mit: openssl rand -base64 32. Ohne Wert bleibt das Mail-Modul aus.
# Rotation: neuen Schlüssel mit neuer ID anhängen, MAIL_ENCRYPTION_KEY_ID umstellen, alten erst
# entfernen, wenn alle Konten neu verschlüsselt sind.
MAIL_ENCRYPTION_KEYS=
MAIL_ENCRYPTION_KEY_ID=
# Nur lokale Entwicklung (z. B. Test-Mailserver auf localhost). In Produktion verboten.
MAIL_ALLOW_PRIVATE_HOSTS=false
# Versandrate pro Kunde und Minute, Wiederholversuche, Grenzen
# Systemmails (Einladung, Passwort vergessen) über ein eigenes Postfach; ohne MAIL_SYSTEM_HOST werden sie nicht versendet.
MAIL_SYSTEM_HOST=
MAIL_SYSTEM_PORT=587
MAIL_SYSTEM_SECURITY=starttls
MAIL_SYSTEM_USER=
MAIL_SYSTEM_PASSWORD=
MAIL_SYSTEM_FROM=
MAIL_SYSTEM_FROM_NAME=Stammbuch
MAIL_RATE_PER_TENANT_PER_MINUTE=60
MAIL_MAX_ATTEMPTS=6
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_RECIPIENTS=5000
