# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (steht in .gitignore).
# Nie echte Zugangsdaten in diese Datei schreiben.

# --- Datenbank (docker-compose.yml, Dienst stammbuch-db) ---
POSTGRES_USER=stammbuch
POSTGRES_DB=stammbuch
# Lokal ein zufälliges Passwort setzen, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_LOKAL_EIN_PASSWORT_SETZEN

# --- API ---
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300
# Nur auf true setzen, wenn ein vertrauenswürdiger Reverse-Proxy davorsteht
TRUST_PROXY=false
# Verbindung der API als Rolle stammbuch_app (nie als Eigentümer). Ohne Wert startet die API nicht.
# Passwort: APP_DB_PASSWORD beim Migrieren (siehe packages/db/README.md). Produktiv mit sslmode=verify-full (SR-40).
DATABASE_URL=postgres://stammbuch_app:HIER_APP_DB_PASSWORD@127.0.0.1:55432/stammbuch
