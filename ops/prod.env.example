# Vorlage für ops/prod.env auf dem Server (Rechte 600). Nie echte Werte ins Repository (SR-30, SR-32).

# Domain, unter der die Anwendung erreichbar ist (DNS zeigt auf den Server).
DOMAIN=stammbuch.example.invalid
# Registry und Version der Images (zum Beispiel ghcr.io/<konto>). IMAGE_TAG immer eine feste Version, nie "latest".
IMAGE_PREFIX=registry.example.invalid/stammbuch
IMAGE_TAG=0.0.0
