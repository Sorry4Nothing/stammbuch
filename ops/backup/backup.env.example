# Vorlage für /etc/stammbuch/backup.env (Besitzer root, Rechte 600). Nie echte Werte ins Repository.
# Das Passwort der Datenbank steht NICHT hier, sondern in einer pgpass-Datei (siehe PGPASSFILE).

# --- Ziel der Sicherungen ---
BACKUP_DIR=/var/backups/stammbuch
# Öffentlicher age-Schlüssel (beginnt mit age1). Den privaten Schlüssel nie auf den Server legen.
AGE_RECIPIENT=age1HIER_OEFFENTLICHEN_SCHLUESSEL_EINTRAGEN

# --- Aufbewahrung (Anzahl Sicherungen je Stufe) ---
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# --- Datenbank (libpq-Variablen) ---
PGHOST=db.example.invalid
PGPORT=5432
PGDATABASE=stammbuch
# Eigene Rolle nur zum Lesen (pg_read_all_data), nicht die Rolle der Anwendung und nicht der Besitzer.
PGUSER=stammbuch_backup
PGSSLMODE=verify-full
PGPASSFILE=/etc/stammbuch/pgpass

# --- Optional: Kopie ausserhalb des Servers (rclone-Ziel, zum Beispiel crypt-Remote) ---
# OFFSITE_REMOTE=offsite:stammbuch

# --- Optional: Lebenszeichen-Ping nach erfolgreicher Sicherung ---
# HEALTHCHECK_URL=https://hc.example.invalid/ping/UUID

# --- Prüfung (verify.sh) ---
MAX_AGE_HOURS=26
MIN_BYTES=1024
