# Vorlage für ops/api.env (und sinngemäss ops/worker.env) auf dem Server, Rechte 600.
# Nie echte Werte ins Repository (SR-30, SR-32). Produktions-Geheimnisse liegen nicht auf Entwicklerrechnern.

NODE_ENV=production
LOG_LEVEL=info
# Anfragen pro Minute und Client-IP (SR-71)
RATE_LIMIT_MAX=300

# Systemmails (Einladung, Passwort vergessen) über ein eigenes Postfach des Anbieters. Ohne MAIL_SYSTEM_HOST
# werden sie nicht versendet. APP_ORIGIN muss die öffentliche Adresse der Oberfläche sein (Links in den Mails).
MAIL_SYSTEM_HOST=
MAIL_SYSTEM_PORT=587
MAIL_SYSTEM_SECURITY=starttls
MAIL_SYSTEM_USER=
MAIL_SYSTEM_PASSWORD=
MAIL_SYSTEM_FROM=
MAIL_SYSTEM_FROM_NAME=Stammbuch

# Folgt mit den Issues #3 (Datenbank) und #4 (Anmeldung); die genauen Namen legen diese Issues fest:
# - Verbindung zur Datenbank: Login-Rolle der Anwendung (nicht Besitzer, ohne BYPASSRLS), sslmode=verify-full
# - Schlüssel für Sitzungen und zur Verschlüsselung von Postfach-Zugangsdaten (zufällig, rotierbar)
# - Schlüsselrotation: API und Worker brauchen dieselben Werte für MAIL_ENCRYPTION_KEYS / MAIL_ENCRYPTION_KEY_ID und
#   AUTH_TOTP_KEY / AUTH_TOTP_KEYS / AUTH_TOTP_KEY_ID (siehe .env.example). Der Worker rotiert stündlich,
#   der Chef-Admin kann mit POST /admin/rotation sofort auslösen und liest den Stand mit GET /admin/rotation.
